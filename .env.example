# Orquestador corre LOCAL en tu dispositivo (PC o Android).
# Este archivo se copia como .env.local y nunca sale de tu aparato.
# Lo único necesario es la clave del proveedor de IA.

# ===========================================
# Proveedor de IA del Orquestador (lo necesario)
# Genérico compatible con OpenAI. Por defecto apunta a
# NVIDIA NIM; cambiando la URL y el modelo sirve cualquier
# endpoint compatible (OpenAI, xAI, un servidor local...).
# ===========================================
# LLM_API_KEY=
# Como respaldo se usa NVIDIA_API_KEY si LLM_API_KEY no está.
# NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_PROVIDER_NAME=NVIDIA NIM

# ===========================================
# Navegador (modalidad 100% navegador)
# El navegador vive en este mismo dispositivo.
# Ver docs/NAVEGADOR.md
# ===========================================
# BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# BROWSER_STATE_PATH=.data/browser-state.json
# BROWSER_CDP_URL=

# ===========================================
# OPCIONAL — Login OAuth con la App de Meta
# Solo si querés listar tus Páginas por API. Sin estas
# variables la app arranca en modo navegador y funciona
# igual para interactuar.
# (https://developers.facebook.com)
# ===========================================
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# Generar con: openssl rand -base64 32
# NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
FACEBOOK_GRAPH_VERSION=v21.0
